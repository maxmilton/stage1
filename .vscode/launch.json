{
  "version": "0.2.0",
  "configurations": [
    {
      // NOTE: Use `bun --inspect` to open a debug port.
      "name": "Attach to Bun",
      "type": "bun",
      "request": "attach",
      "url": "ws://localhost:6499/"
    },
    {
      "name": "bun <CURRENT_FILE>",
      "type": "bun",
      "request": "launch",
      "runtime": "bun",
      "runtimeArgs": [], // bun exec arguments
      "cwd": "${workspaceFolder}",
      "program": "${file}",
      "args": [], // program arguments
      "env": {},
      "strictEnv": true,
      "watchMode": false,
      "stopOnEntry": false,
      "noDebug": false, // disable debugger (ignore breakpoints)
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
