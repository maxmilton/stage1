{
  "name": "stage1",
  "version": "0.11.0-next.0",
  "description": "High-performance JavaScript micro framework",
  "bugs": "https://github.com/maxmilton/stage1/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": "github:maxmilton/stage1",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "browser": "dist/browser.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./macro": {
      "types": "./dist/index.d.ts",
      "default": "./dist/macro.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "bun": "./src/browser/index.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./reconcile/keyed": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/keyed.ts",
      "default": "./dist/reconcile/keyed.js"
    },
    "./reconcile/non-keyed": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/non-keyed.ts",
      "default": "./dist/reconcile/non-keyed.js"
    },
    "./reconcile/reuse-nodes": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/reuse-nodes.ts",
      "default": "./dist/reconcile/reuse-nodes.js"
    },
    "./fast": "./src/fast/index.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:js2 && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:js2": "eslint",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=50",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@maxmilton/eslint-config": "0.3.5",
    "@maxmilton/oxlint-config": "0.0.19",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "dts-buddy": "0.8.3",
    "eslint": "10.10.0",
    "eslint-plugin-oxlint": "1.83.0",
    "eslint-plugin-unicorn": "76.0.0",
    "happy-dom": "20.14.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "rollup": "4.63.3",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
