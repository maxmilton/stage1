{
  "name": "stage1",
  "version": "0.12.1",
  "description": "High-performance JavaScript micro framework",
  "bugs": "https://github.com/maxmilton/stage1/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmilton/stage1.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "browser": "dist/browser.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js",
      "macro": "./dist/macro.js"
    },
    "./macro": {
      "types": "./dist/index.d.ts",
      "default": "./dist/macro.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "bun": "./src/browser/index.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./reconcile/keyed": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/keyed.ts",
      "default": "./dist/reconcile/keyed.js"
    },
    "./reconcile/non-keyed": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/non-keyed.ts",
      "default": "./dist/reconcile/non-keyed.js"
    },
    "./reconcile/reuse-nodes": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/reuse-nodes.ts",
      "default": "./dist/reconcile/reuse-nodes.js"
    },
    "./reconcile/reuse-lite": {
      "types": "./dist/index.d.ts",
      "bun": "./src/reconcile/reuse-lite.ts",
      "default": "./dist/reconcile/reuse-lite.js"
    },
    "./fast": "./src/fast/index.ts",
    "./ng": "./src/ng/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --parallel --no-isolate --rerun-each=50",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.24",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "dts-buddy": "0.8.3",
    "happy-dom": "21.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "reactive-framework-test-suite": "0.1.0",
    "rollup": "4.66.0",
    "terser": "5.51.2",
    "typescript": "6.0.3"
  }
}
