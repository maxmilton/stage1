{
  "name": "stage1",
  "version": "0.12.1",
  "description": "High-performance JavaScript micro framework",
  "bugs": "https://github.com/maxmilton/stage1/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmilton/stage1.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "browser": "dist/browser.js",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lite": "./src/lite/index.ts",
    "./macro": {
      "types": "./dist/macro.d.ts",
      "default": "./dist/macro.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "bun": "./src/browser/index.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "bun": "./src/legacy/index.ts",
      "default": "./dist/legacy/index.js"
    },
    "./legacy/reconcile/keyed": {
      "types": "./dist/legacy/reconcile/keyed.d.ts",
      "bun": "./src/legacy/reconcile/keyed.ts",
      "default": "./dist/legacy/reconcile/keyed.js"
    },
    "./legacy/reconcile/non-keyed": {
      "types": "./dist/legacy/reconcile/non-keyed.d.ts",
      "bun": "./src/legacy/reconcile/non-keyed.ts",
      "default": "./dist/legacy/reconcile/non-keyed.js"
    },
    "./legacy/reconcile/reuse-nodes": {
      "types": "./dist/legacy/reconcile/reuse-nodes.d.ts",
      "bun": "./src/legacy/reconcile/reuse-nodes.ts",
      "default": "./dist/legacy/reconcile/reuse-nodes.js"
    },
    "./legacy/reconcile/reuse-lite": {
      "types": "./dist/legacy/reconcile/reuse-lite.d.ts",
      "bun": "./src/legacy/reconcile/reuse-lite.ts",
      "default": "./dist/legacy/reconcile/reuse-lite.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --parallel --no-isolate --rerun-each=50",
    "test:e2e": "playwright test",
    "test:prod": "NODE_ENV=production bun test"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.24",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "happy-dom": "21.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "reactive-framework-test-suite": "0.2.0",
    "rolldown": "1.3.0",
    "rolldown-plugin-dts": "0.30.0",
    "typescript": "7.0.2"
  }
}
